{
  "name": "lora-emotional-engine-v1",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "chat": "ts-node src/emotion-core/debug/chat-cli.ts",
    "dev:adapter": "ts-node src/server/adapter.ts",
    "dev:test": "ts-node scripts/run-dev-test.ts",
    "check:contracts": "npm test",
    "check:smoke": "bash scripts/smoke.sh",
    "check:all": "npm run check:contracts && npm run check:smoke",
    "leakage-scan": "ts-node src/appraisal-lab/cli/leakage_scan.ts",
    "eval-modes": "ts-node src/appraisal-lab/cli/eval_modes.ts",
    "layer2:validate-mapping": "ts-node src/appraisal-lab/cli/validate_mapping.ts",
    "layer2:build-dataset": "ts-node src/appraisal-lab/layer2/build_likelihood_dataset.ts",
    "layer2:build-likelihood-table": "ts-node src/appraisal-lab/layer2/build_likelihood_table.ts",
    "layer2:inspect-likelihood": "ts-node src/appraisal-lab/layer2/inspect_likelihood_direction.ts",
    "layer2:compute-irr": "ts-node src/appraisal-lab/layer2/compute_irr.ts",
    "layer2:compute-weights": "ts-node src/appraisal-lab/layer2/compute_dimension_weights.ts",
    "layer2:build-likelihood-ekman6": "ts-node src/appraisal-lab/layer2/build_likelihood_table_ekman6.ts",
    "layer2:inspect-ekman6": "ts-node src/appraisal-lab/layer2/inspect_ekman6_behavior.ts",
    "layer2:inspect-ekman6-v2": "ts-node src/appraisal-lab/layer2/inspect_ekman6_behavior_v2.ts",
    "layer2:inspect-ekman6-v1_2": "ts-node src/appraisal-lab/layer2/inspect_ekman6_behavior_v2.ts --report docs/layer2/inspect_ekman6_behavior_v1_2.md",
    "layer2:inspect-ekman6-v1_3": "ts-node src/appraisal-lab/layer2/inspect_ekman6_behavior_v1_3.ts",
    "layer2:build-gold": "ts-node src/appraisal-lab/layer2/build_gold_appraisals.ts",
    "layer2:run-rule-mapper-test": "ts-node src/appraisal-lab/layer2/run_rule_mapper_on_test.ts",
    "layer2:validate-rule-mapper": "ts-node src/appraisal-lab/layer2/validate_rule_mapper.ts",
    "layer2:build-envent-likelihood": "ts-node src/appraisal-lab/layer2/build_envent_likelihood.ts",
    "layer2:compare-envent-likelihood": "ts-node src/appraisal-lab/layer2/compare_envent_likelihoods.ts",
    "layer2:evaluate-v1": "ts-node src/appraisal-lab/layer2/evaluate_model_v1.ts",
    "layer2:calibrate": "ts-node src/appraisal-lab/layer2/calibrate_emotion_classifier.ts",
    "layer2:validate-gating": "ts-node src/appraisal-lab/layer2/validate_gating.ts",
    "memory:v1:shadow-smoke": "ts-node scripts/memory_v1_shadow_smoke.ts",
    "memory:v1:live-smoke": "ts-node scripts/memory_v1_live_smoke.ts",
    "memory:v1:debug-smoke": "ts-node scripts/memory_v1_debug_smoke.ts",
    "memory:v1:shadow-report": "ts-node scripts/memory_v1_shadow_report.ts",
    "memory:v1:stress": "ts-node scripts/memory_v1_stress_run.ts",
    "chroma:smoke": "ts-node src/emotion-core/memory-v1/db/__smoke__/chromaSmokeTest.ts",
    "chroma:start": "docker compose -f docker-compose.chroma.yml up -d",
    "chroma:stop": "docker compose -f docker-compose.chroma.yml down",
    "chroma:health": "curl -sf http://localhost:8000/api/v2/heartbeat && echo ' chroma OK' || echo 'chroma UNREACHABLE'",
    "chroma:logs": "docker compose -f docker-compose.chroma.yml logs -f",
    "falkor:start": "docker compose -f docker-compose.falkor.yml up -d",
    "falkor:stop": "docker compose -f docker-compose.falkor.yml down",
    "falkor:logs": "docker compose -f docker-compose.falkor.yml logs -f",
    "demo:fact-anchors": "ts-node scripts/demo-fact-anchors.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "chromadb": "^3.3.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "openai": "^6.16.0",
    "ioredis": "^5.6.0"
  }
}
