{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["jest", "node"]
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/* 2.ts",
    "src/**/* 3.ts",
    "src/**/* 4.ts",
    "src/**/* 5.ts",
    "src/**/* 6.ts",
    "src/**/* 7.ts",
    "src/**/* 2.json",
    "src/**/* 3.json",
    "src/**/* 4.json"
  ],
  "baseUrl": "src",
    "paths": {
      "@emotion/*": ["emotion-core/*"]
    }
}
