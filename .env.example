# Copy to .env and set real values. Required for Railway/production.

NODE_ENV=production
PORT=3000
LORA_DEBUG=false

# LLM (required)
ANTHROPIC_API_KEY=your_api_key_here

# Memory services
FALKOR_HOST=localhost
FALKOR_PORT=6379
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Analytics (optional — leave blank to disable)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
